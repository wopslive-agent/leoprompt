# Database
DATABASE_URL=mysql://user:password@host:3306/leoprompt

# Auth - generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=your-secret-here

# App
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://yourapp.com
SMS_BATCH_WINDOW_MS=5000

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WEBHOOK_BASE_URL=https://yourapp.com

# Google Calendar OAuth
# Register this exact redirect URI in Google Cloud OAuth settings.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=https://yourapp.com/settings?googleCalendar=callback
# Generate with: openssl rand -base64 32
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Optional separate state-signing secret. Falls back to JWT_SECRET if unset.
# GOOGLE_OAUTH_STATE_SECRET=

# AI Provider — choose one (default: anthropic)
# AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# Ollama (used when AI_PROVIDER=ollama — keep on localhost, do not expose publicly)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b

# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_AGENCY_PRICE_ID=
